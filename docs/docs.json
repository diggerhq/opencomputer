{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenComputer",
  "description": "Cloud sandboxes for running AI agents",
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "colors": {
    "primary": "#131311",
    "light": "#dfdfdf",
    "dark": "#131311"
  },
  "favicon": "/images/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "getting-started/introduction",
          "getting-started/quickstart",
          "getting-started/architecture"
        ]
      },
      {
        "group": "Use in Slack",
        "pages": [
          "slack/threads",
          "slack/shared-threads",
          "slack/linked-and-spawned-threads",
          "slack/mid-turn-messages",
          "slack/permission-modes",
          "slack/approvals-questions-plans",
          "slack/subagents",
          "slack/files-and-cards",
          "slack/browser-screenshots-video",
          "slack/branches-and-pull-requests",
          "slack/preview-urls",
          "slack/models-and-harnesses",
          "slack/secrets-and-variables",
          "slack/troubleshooting"
        ]
      },
      {
        "group": "Self-hosting @computer",
        "pages": [
          "self-hosting/overview",
          "self-hosting/gateway",
          "self-hosting/host-vm",
          {
            "group": "Providers",
            "pages": [
              "self-hosting/providers/aws",
              "self-hosting/providers/azure",
              "self-hosting/providers/gcp",
              "self-hosting/providers/vps"
            ]
          },
          "self-hosting/github",
          "self-hosting/configure",
          "self-hosting/operate",
          "self-hosting/security",
          "self-hosting/troubleshooting"
        ]
      },
      {
        "group": "API and CLI",
        "pages": [
          "api/overview",
          "api/sessions",
          "api/turns",
          "api/events",
          "api/asks",
          "api/subagents",
          "api/terminals",
          "api/files",
          "api/cli"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/slack-commands",
          "reference/agent-tools",
          "reference/configuration",
          "reference/limits",
          "reference/api-schema"
        ]
      },
      {
        "group": "Serverless Agents",
        "pages": [
          {
            "group": "Getting started",
            "pages": [
              "agents/overview",
              "agents/mental-model",
              "agents/quickstart",
              "agents/projects"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "agents/reactive-agents",
              "agents/sessions",
              "agents/memory",
              "agents/database",
              "agents/schedules",
              "agents/webhooks",
              "agents/capabilities",
              "agents/secrets",
              "agents/services",
              "agents/github",
              "agents/slack",
              "agents/linear",
              "agents/byok",
              "agents/deployments",
              "agents/regions",
              "agents/egress"
            ]
          },
          {
            "group": "Build an application",
            "pages": [
              "agents/react",
              "reference/typescript-sdk/agents",
              "agents/api",
              "agents/events"
            ]
          },
          {
            "group": "Agent API",
            "pages": [
              "agents/hooks",
              "agents/inputs",
              "agents/models",
              "agents/tools",
              "agents/mcp",
              "agents/skills",
              "agents/session-data",
              "agents/document-memory",
              "agents/memory-providers"
            ]
          },
          {
            "group": "Test and operate",
            "pages": [
              "agents/playground",
              "agents/logs"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "agents/examples/gtm-engineer",
              "agents/examples/feature-flag-hygiene",
              "agents/examples/slack-coder",
              "agents/examples/pr-review",
              "agents/examples/test-coverage"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://opencomputer.dev"
  },
  "api": {
    "mdx": {
      "server": "https://app.opencomputer.dev",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "redirects": [
    {
      "source": "/agents/examples/exa-research-session",
      "destination": "/agents/examples/gtm-engineer"
    },
    {
      "source": "/agents/channels",
      "destination": "/agents/slack"
    },
    {
      "source": "/agents/outboxes",
      "destination": "/agents/database"
    },
    {
      "source": "/agents/examples/github-actions-triage",
      "destination": "/agents/webhooks"
    }
  ],
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#f8f6f1",
      "dark": "#0f0f0f"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/diggerhq/opencomputer"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.opencomputer.dev"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/diggerhq/opencomputer"
    }
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  }
}
