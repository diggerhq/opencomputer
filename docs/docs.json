{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenComputer",
  "description": "Cloud sandboxes for running AI agents",
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "colors": {
    "primary": "#131311",
    "light": "#dfdfdf",
    "dark": "#131311"
  },
  "favicon": "/images/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Serverless Agents",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "agents/overview",
              "agents/mental-model",
              "agents/quickstart",
              "agents/projects"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "agents/reactive-agents",
              "agents/sessions",
              "agents/memory",
              "agents/database",
              "agents/schedules",
              "agents/webhooks",
              "agents/capabilities",
              "agents/secrets",
              "agents/services",
              "agents/github",
              "agents/slack",
              "agents/linear",
              "agents/byok",
              "agents/deployments"
            ]
          },
          {
            "group": "Build an application",
            "pages": [
              "agents/react",
              "reference/typescript-sdk/agents",
              "agents/api",
              "agents/events"
            ]
          },
          {
            "group": "Agent API",
            "pages": [
              "agents/hooks",
              "agents/inputs",
              "agents/models",
              "agents/tools",
              "agents/mcp",
              "agents/skills",
              "agents/subagents",
              "agents/session-data",
              "agents/document-memory",
              "agents/memory-providers"
            ]
          },
          {
            "group": "Test and operate",
            "pages": [
              "agents/playground",
              "agents/logs"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "agents/examples/gtm-engineer",
              "agents/examples/feature-flag-hygiene",
              "agents/examples/slack-coder",
              "agents/examples/pr-review",
              "agents/examples/test-coverage"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://opencomputer.dev"
  },
  "api": {
    "mdx": {
      "server": "https://app.opencomputer.dev",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "redirects": [
    {
      "source": "/agents/examples/exa-research-session",
      "destination": "/agents/examples/gtm-engineer"
    },
    {
      "source": "/agents/channels",
      "destination": "/agents/slack"
    },
    {
      "source": "/agents/outboxes",
      "destination": "/agents/database"
    },
    {
      "source": "/agents/examples/github-actions-triage",
      "destination": "/agents/webhooks"
    }
  ],
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#f8f6f1",
      "dark": "#0f0f0f"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/diggerhq/opencomputer"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.opencomputer.dev"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/diggerhq/opencomputer"
    }
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  }
}
