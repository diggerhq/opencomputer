{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencomputer-vm-do-poc-mo-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "10a2123d1440c5fbf090968ca59bfb28",
  "routes": [
    {
      "pattern": "vm-do-poc.mo-oc-dev.com",
      "zone_name": "mo-oc-dev.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VM_SESSIONS",
        "class_name": "VmSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VmSession"]
    }
  ],
  "vars": {
    "POC_VM_ID": "vm-seoul-1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
