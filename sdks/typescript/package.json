{
  "name": "@opencomputer/sdk",
  "version": "3.0.0",
  "description": "TypeScript client for the OpenComputer Serverless Agents management API (@opencomputer/sdk/agents)",
  "type": "module",
  "exports": {
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencomputer",
    "serverless-agents",
    "agents",
    "management-api"
  ],
  "author": "OpenComputer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diggerhq/opencomputer.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/diggerhq/opencomputer/tree/main/sdks/typescript",
  "bugs": {
    "url": "https://github.com/diggerhq/opencomputer/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
