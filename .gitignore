# OS files
.DS_Store
Thumbs.db

# Editor/IDE files
.cursor/
*.swp
*.swo
*~
.idea/
.vscode/

# Claude Code session state — never check in
.claude/*.lock
.claude/settings.local.json

# Environment files
.env
.env.*
!.env.example
# Cloudflare Worker local secrets (wrangler dev)
.dev.vars
.dev.vars.*

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Node
node_modules/

# api-edge Workers Assets — copied from web/dist at deploy time. Source of truth lives in web/.
cloudflare-workers/api-edge/assets/

# Build artifacts
dist/
# Built dashboard SPA bundle served by the api-edge Worker — produced by
# `vite build` in web/, copied here by the deploy script. Never check in.
cloudflare-workers/api-edge/assets/

# Loom demo (private)
sdks/typescript/examples/loom/

# Media files
*.mp4
*.gif

# Temp files
*.tmp
*.log
delme

# Claude Code agent memory (session-local, not source)
/memory/

# Per-env wrangler config generated for CI deploys (not source)
cloudflare-workers/api-edge/wrangler.ci.toml

# Wrangler local build/cache/state (never source)
.wrangler/

.dev.vars*
!.dev.vars.example
cloudflare-workers/api-edge/wrangler.*.generated.jsonc
