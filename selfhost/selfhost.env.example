# /etc/opencomputer/selfhost.env: the host agent's side of a self-hosted
# computer (selfhost/CONTRACT.md). Owner root:root, mode 0600. systemd reads it
# for slack-presence-host.service (EnvironmentFile=). The host runs as sp-host
# and cannot read it; sessions run as agent and cannot read it.
#
# Copy it, fill it in, then (re)start the host:
#   sudo install -m 0600 -o root -g root selfhost/selfhost.env.example /etc/opencomputer/selfhost.env
#   sudoedit /etc/opencomputer/selfhost.env
#   sudo selfhost/host-install.sh        # or: sudo systemctl restart slack-presence-host
#
# host-install.sh never writes this file and never prints it. It starts the
# host only once SP_HOST_TOKEN here has a value.
#
# Set by the unit or its drop-ins, not here: SP_DATA, SP_RUN, SP_LAUNCH=podman,
# SP_RUNNER_USER, SP_RUNNER_PATH, SP_MODEL_PROXY, SP_DEFINITION, SP_VERSION,
# SP_IMAGE, SP_IMAGE_ABI, HOME, PATH, XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS.
# A value set here wins over the unit's Environment= lines; leave those alone.

# ---- required

# The local gateway's host endpoint: a WebSocket, path /host. The gateway
# container publishes its port on loopback only (127.0.0.1:GATEWAY_PORT in
# selfhost/.env, default 8080), so the host dials it there, never through
# the tunnel. Change the port here if GATEWAY_PORT changes.
SP_GATEWAY_URL=ws://127.0.0.1:8080/host

# Secret. The bearer token the host sends on that WebSocket. It must also be in
# the gateway's SP_HOST_TOKENS (comma list, selfhost/.env), or be one /setup issued
# ("Host" step, sph_...). Generate one with: openssl rand -hex 32
SP_HOST_TOKEN=

# This host's id in the gateway's hosts table. Keep it stable: a reinstall
# with the same id takes over the same people and sessions.
SP_HOST_ID=selfhost

# ---- optional tuning (defaults in brackets)

# Memory cap of one session [16G; limits.sh may set a lower machine-wide cap].
# SP_RUNNER_MEMORY_MAX=8G
# A session's runner exits after this long idle, in ms [7200000].
# SP_IDLE_MS=7200000
# Spare runners kept warm [2].
# SP_POOL_SIZE=2
# Build artifacts of a workspace idle this long are pruned, in hours [24].
# SP_ARTIFACTS_IDLE_HOURS=24

# ---- leave unset on a self-hosted computer

# Performance telemetry to OpenComputer's collector. Unset: nothing leaves.
# SP_TELEMETRY_URL=
# SP_TELEMETRY_CREDENTIAL=
# SP_REGION=
# SP_SUBSTRATE=
