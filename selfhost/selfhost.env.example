# /etc/opencomputer/selfhost.env: the host agent's side of a self-hosted
# computer (selfhost/CONTRACT.md). Owner root:root, mode 0600. systemd reads it
# for slack-presence-host.service (EnvironmentFile=). The host runs as sp-host
# and cannot read it; sessions run as agent and cannot read it.
#
# The three required lines come from the running gateway container. Once the
# compose stack is up, write them and (re)start the host with:
#   sudo selfhost/host-install.sh --link-gateway
# It reads the gateway's GATEWAY_ORG, GATEWAY_PORT and /data/host-token as
# oc-gateway, rewrites only those three lines here (creating this file from the
# example if needed) and never prints the token. Other lines are yours:
#   sudoedit /etc/opencomputer/selfhost.env && sudo systemctl restart slack-presence-host
#
# An install never writes this file. It starts the host only once
# SP_HOST_TOKEN here has a value.
#
# Set by the unit or its drop-ins, not here: SP_DATA, SP_RUN, SP_LAUNCH=podman,
# SP_RUNNER_USER, SP_RUNNER_PATH, SP_MODEL_PROXY, SP_DEFINITION, SP_VERSION,
# SP_IMAGE, SP_IMAGE_ABI, HOME, PATH, XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS.
# A value set here wins over the unit's Environment= lines; leave those alone.

# ---- required

# The local gateway's host endpoint: a WebSocket on the Computer path, with the
# gateway's one organization (GATEWAY_ORG in
# /var/lib/oc-gateway/opencomputer/selfhost/.env, default org_selfhost). The
# gateway container publishes its port on loopback only (127.0.0.1:GATEWAY_PORT,
# default 8080), so the host dials it there, never through the tunnel.
SP_GATEWAY_URL=ws://127.0.0.1:8080/v1/computer/host?organizationId=org_selfhost

# Secret. The bearer token the host sends on that WebSocket: the contents of
# /data/host-token in the gateway's volume (sph_..., derived from the
# gateway's own key and the organization, so it is stable while the volume
# is). --link-gateway copies it here; /setup's Host step shows it masked.
SP_HOST_TOKEN=

# The host's id: the gateway's organization, as in the URL.
SP_HOST_ID=org_selfhost

# ---- optional tuning (defaults in brackets)

# Memory cap of one session [16G; limits.sh may set a lower machine-wide cap].
# SP_RUNNER_MEMORY_MAX=8G
# A session's runner exits after this long idle, in ms [7200000].
# SP_IDLE_MS=7200000
# Spare runners kept warm [2].
# SP_POOL_SIZE=2
# Build artifacts of a workspace idle this long are pruned, in hours [24].
# SP_ARTIFACTS_IDLE_HOURS=24

# ---- leave unset on a self-hosted computer

# Performance telemetry to OpenComputer's collector. Unset: nothing leaves.
# SP_TELEMETRY_URL=
# SP_TELEMETRY_CREDENTIAL=
# SP_REGION=
# SP_SUBSTRATE=
