# Single-VM self-host (spike: hosted gateway under Miniflare). Copy to .env next
# to compose.yaml (mode 0600). Never commit .env.

# The operator's credential: /setup's sign-in and the bearer for /v1/computer.
# `openssl rand -hex 32`.
SETUP_TOKEN=

# The gateway's public HTTPS origin (the tunnel's or proxy's), no trailing
# slash. The dashboard's sign-in and Slack need it. (SP_ORIGIN is its older name.)
PUBLIC_URL=

# 1: keep /setup open after the Claude credential and host are set up.
SP_SETUP_OPEN=

# The one organization this gateway serves; the host agent's SP_HOST_ID.
GATEWAY_ORG=org_selfhost

# Host-side port, bound to 127.0.0.1 only. The container always listens on 8080.
GATEWAY_PORT=8080

# Unset: build selfhost/gateway/Dockerfile. Set to skip the build.
GATEWAY_IMAGE=

# The sessions' Anthropic key (optional; the host's model proxy profiles can carry one instead).
ANTHROPIC_API_KEY=

# Optional: keep attachments in an S3-compatible store (R2, S3, MinIO) instead
# of the gateway's volume. All four, or none; the region defaults to `auto`.
# The bucket's CORS must allow PUT, GET and HEAD from any origin.
ATTACHMENTS_S3_ENDPOINT=
ATTACHMENTS_S3_BUCKET=
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
ATTACHMENTS_S3_REGION=

# --profile cloudflared: a named tunnel's token; service http://gateway:8080.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=latest

