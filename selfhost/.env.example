# Single-VM self-host: copy to .env next to compose.yaml and fill in.
# Never commit .env. Generate keys with `openssl rand -hex 32`.
# Guide: docs/self-hosting/single-vm.mdx

# ---------------------------------------------------------------- required

# The gateway's public HTTPS origin, no trailing slash: the tunnel's hostname.
# Slack's event, interactivity and OAuth URLs are built from it.
SP_ORIGIN=https://computer.example.com

# Opens /setup: visit <SP_ORIGIN>/setup?token=<SETUP_TOKEN> once.
SETUP_TOKEN=

# Encrypts the secrets the gateway stores in SQLite (Slack and GitHub app
# credentials, Claude credential, session secrets). Losing it makes them
# unreadable; back it up with the volume.
SP_STORE_KEY=

# ---------------------------------------------------------------- gateway

# Host-side port, bound to 127.0.0.1 only. The host agent's SP_GATEWAY_URL is
# ws://127.0.0.1:<GATEWAY_PORT>/host. The container always listens on 8080.
GATEWAY_PORT=8080

# Comma-separated host tokens the gateway accepts, in addition to tokens issued
# on /setup. Put the same value in the host agent's SP_HOST_TOKEN.
SP_HOST_TOKENS=

# People who may use the instance, upserted on every start. JSON array, e.g.
# [{"slackUserId":"U0123ABCD","dir":"ada","gitName":"Ada","gitEmail":"ada@example.com","admin":true}]
# Anyone not listed is ignored, including whoever installs the Slack app.
SP_PEOPLE=[]

# The GitHub organization that will own the GitHub App created on /setup.
GITHUB_ORG=

# App and bot name of the Slack app created on /setup.
SLACK_APP_NAME=Computer

# default | acceptEdits | plan | auto | bypassPermissions
PERMISSION_MODE=bypassPermissions

# ---------------------------------------------------------------- image

# Unset: build from ../computer. Set to a published image to skip the build,
# e.g. ghcr.io/diggerhq/computer-gateway:1.2.3, then `podman compose pull gateway`.
GATEWAY_IMAGE=
# Version the gateway reports on /healthz when built from source.
SP_VERSION=dev

# ---------------------------------------------------------------- models (optional)

# The sessions' model credentials. /setup can store a Claude credential instead.
# MODEL_PROFILE + MODEL_TOKEN win over the two Claude ones below.
MODEL_PROFILE=
MODEL_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Codex, for threads started with +codex.
OPENAI_API_KEY=

# ---------------------------------------------------------------- Slack app (optional)

# Leave empty to create the app on /setup (recommended). Set only for an app
# you created by hand; values here win over what /setup stored.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
SLACK_TEAM_ID=

# ---------------------------------------------------------------- tunnel (one of)

# --profile cloudflared: a named tunnel's token (Zero Trust > Networks >
# Tunnels). Its public hostname is SP_ORIGIN's, service http://gateway:8080.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=latest

# --profile ngrok: authtoken and a reserved domain; SP_ORIGIN=https://<NGROK_URL>.
NGROK_AUTHTOKEN=
NGROK_URL=
NGROK_VERSION=latest
