#!/usr/bin/env bash
# A fake curl for selfhost/test: answers from $FAKE_CURL/<METHOD><path with / as _>
# (body) and its .code (HTTP status, default 200). No file: exit 7, as curl does
# when nothing listens (or $FAKE_CURL/timeout: exit 28). With -f a status >= 400
# exits 22 and prints nothing. Every call is logged to $FAKE_CURL/calls.
set -u
method=GET fail=0 url=""
while (($#)); do
  case $1 in
    -X) method="$2"; shift ;;
    -H|-m|-o|-w) shift ;;
    -f*|-s*) [[ $1 == *f* ]] && fail=1 ;;
    http*) url="$1" ;;
  esac
  shift
done
path="/${url#*://*/}"
echo "$method $path" >>"$FAKE_CURL/calls"
[[ ! -f $FAKE_CURL/timeout ]] || exit 28
key="$FAKE_CURL/$method${path//\//_}"
[[ -f $key ]] || exit 7
code="$(cat "$key.code" 2>/dev/null || echo 200)"
if ((code >= 400)) && [[ $fail == 1 ]]; then exit 22; fi
cat "$key"
