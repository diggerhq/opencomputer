{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Tracks and threads tests: Delivery alone, with fakes of Org, SessionLog and the Slack actor.
  "name": "delivery-test",
  "main": "test/fixtures/delivery-test-worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "DELIVERY", "class_name": "DeliveryDurableObject" },
      { "name": "ORGS", "class_name": "FakeOrg" },
      { "name": "SESSION_LOG", "class_name": "FakeSessionLog" },
      { "name": "SLACK", "class_name": "FakeSlack" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeliveryDurableObject", "FakeOrg", "FakeSessionLog", "FakeSlack"] }]
}
