{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "commands-integrated-test",
  "main": "test/fixtures/memory-integrated-worker.mjs",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BLUE_ENVIRONMENT": "development",
    "BLUE_ACCOUNT_ID": "local",
    "BLUE_DEFAULT_MODEL": "openrouter/anthropic/claude-sonnet-4.6",
    "BLUE_GOOGLE_CLIENT_ID": "test-google-client",
    "BLUE_CHANNEL_ENCRYPTION_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
    "OC_MANAGED_CRED_HMAC_SECRET": "test-managed-credential-secret",
    "BLUE_SESSION_INDEX_ADMIN_SECRET": "test-session-index-admin-secret",
    "OPENCOMPUTER_APP_URL": "https://app.example",
    "OPENROUTER_API_KEY": "test-openrouter-key",
    "DATABASE_MCP_ENABLED": "false",
    "SANDBOX_IDLE_GRACE_MS": "60000",
    "SANDBOX_POLL_MARGIN_MS": "750",
    "WORKERD_STOP_TIMEOUT_MS": "750"
  },
  "d1_databases": [
    {
      "binding": "SERVERLESS_AGENTS_DB",
      "database_name": "commands-integrated-test",
      "database_id": "00000000-0000-0000-0000-000000000022",
      "migrations_dir": "migrations"
    }
  ],
  "worker_loaders": [{ "binding": "AGENT_LOADER" }],
  "services": [{ "binding": "WORKERD_RUNTIME", "service": "commands-integrated-test" }],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountDurableObject" },
      { "name": "SESSIONS", "class_name": "SessionDurableObject" },
      { "name": "MEMORY", "class_name": "MemoryDurableObject" },
      { "name": "OPENCODE_SESSIONS", "class_name": "OpenCodeSessionDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountDurableObject",
        "SessionDurableObject",
        "MemoryDurableObject",
        "OpenCodeSessionDurableObject"
      ]
    }
  ]
}
