  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Machine health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Live fleet machine health, refreshed every 30 seconds, in five-minute UTC buckets. Machine labels are anonymized and stable across refreshes. These are reporting machines, not a complete inventory of expected machines. The latest bucket is partial."
      }
    },
    {
      "id": 2,
      "title": "CPU utilization",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(occurred_at, INTERVAL 5 MINUTE) AS time, concat('machine-', substring(hex(SHA256(host_id)), 1, 8)) AS machine, max(JSONExtractFloat(data, 'cpu_pct')) AS value FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('host.sample') LIMIT 1 BY event_id) WHERE host_id != '' GROUP BY time, machine ORDER BY time, machine"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
