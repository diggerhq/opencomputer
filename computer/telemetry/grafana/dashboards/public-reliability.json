    {
      "id": 1,
      "type": "text",
      "title": "Reliability",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Live aggregate metrics; refreshes every 30 seconds. Times are UTC. Latency charts use six-hour buckets and show p95 only with 20+ measurements. Current buckets are partial; gaps mean insufficient data. Traffic and model mix can change.\n\nCounts include failures and silent turns. Frontend call events cover slow, failed or rate-limited calls; their latency distribution does not represent every frontend call."
      }
    },
    {
      "id": 2,
      "title": "Slack turn outcomes",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(sent_at, INTERVAL 6 HOUR) AS time, outcome, count() AS turns FROM (SELECT * FROM turns WHERE $__timeFilter(sent_at) AND NOT synthetic AND surface = 'slack' LIMIT 1 BY turn_id) GROUP BY time, outcome ORDER BY time, outcome"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Dispatch and runner trouble",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(occurred_at, INTERVAL 6 HOUR) AS time, event_name, count() AS events FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('queue.retried', 'queue.failed', 'dispatch.parked', 'turn.abandoned') LIMIT 1 BY event_id) GROUP BY time, event_name ORDER BY time, event_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Frontend rate limiting and errors",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(occurred_at, INTERVAL 6 HOUR) AS time, countIf(JSONExtractBool(data, 'rate_limited')) AS rate_limited, countIf(outcome = 'failed') AS failed FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('surface.call') LIMIT 1 BY event_id) GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "custom": {
