    {
      "id": 5,
      "title": "Dropped telemetry by reason",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(occurred_at, INTERVAL 6 HOUR) AS time, JSONExtractString(data, 'reason') AS reason, sum(JSONExtractFloat(data, 'count')) AS dropped FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('telemetry.dropped') LIMIT 1 BY event_id) GROUP BY time, reason ORDER BY time, reason"
        }
      ],
      "fieldConfig": {
