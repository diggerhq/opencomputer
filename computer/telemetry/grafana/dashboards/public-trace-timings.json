    {
      "id": 1,
      "type": "text",
      "title": "Trace timings",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Live aggregate metrics; refreshes every 30 seconds. Times are UTC. Latency charts use six-hour buckets and show p95 only with 20+ measurements. Current buckets are partial; gaps mean insufficient data. Traffic and model mix can change.\n\nThis public counterpart shows aggregate event durations. Individual trace waterfalls, sessions and their identifiers remain in the private trace explorer. Event durations overlap and must not be summed into response time."
      }
    },
    {
      "id": 2,
      "title": "Event duration summary",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT event_name, service_name, count(duration_ms) AS measurements, round(quantile(0.5)(duration_ms)) AS median_ms, if(count(duration_ms) >= 20, round(quantile(0.95)(duration_ms)), NULL) AS p95_ms FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('runner.launched', 'fork.done', 'fork.repo', 'harness.started', 'tool.completed', 'model.request', 'sessionlog.append', 'api.write') LIMIT 1 BY event_id) WHERE duration_ms IS NOT NULL GROUP BY event_name, service_name ORDER BY measurements DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Event duration by stage · p95",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(occurred_at, INTERVAL 6 HOUR) AS time, event_name, if(count(duration_ms) >= 20, quantile(0.95)(duration_ms), NULL) AS p95 FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('runner.launched', 'fork.done', 'tool.completed', 'model.request', 'sessionlog.append', 'api.write') LIMIT 1 BY event_id) WHERE duration_ms IS NOT NULL GROUP BY time, event_name ORDER BY time, event_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
