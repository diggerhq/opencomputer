  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "load1",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(occurred_at) AS time, host_id, max(JSONExtractFloat(data, 'load1')) AS load1 FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('host.sample') LIMIT 1 BY event_id) GROUP BY time, host_id ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
    },
