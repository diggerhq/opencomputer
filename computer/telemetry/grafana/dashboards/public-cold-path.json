        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(occurred_at, INTERVAL 6 HOUR) AS time, quantile(0.5)(duration_ms) AS median, if(count(duration_ms) >= 20, quantile(0.95)(duration_ms), NULL) AS p95 FROM (SELECT * FROM calvin_events WHERE $__timeFilter(occurred_at) AND event_name IN ('fork.repo') LIMIT 1 BY event_id) WHERE duration_ms IS NOT NULL GROUP BY time ORDER BY time"
        }
      ],
