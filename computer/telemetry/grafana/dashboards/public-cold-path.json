    {
      "id": 1,
      "type": "text",
      "title": "Cold path",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Live aggregate metrics; refreshes every 30 seconds. Times are UTC. Latency charts use six-hour buckets and show p95 only with 20+ measurements. Current buckets are partial; gaps mean insufficient data. Traffic and model mix can change.\n\nStartup stages are averages per six-hour bucket. Compare startup paths separately; their traffic volumes differ."
      }
    },
    {
      "id": 2,
      "title": "Startup stages · new",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "calvin-tinybird"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "calvin-tinybird"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(sent_at, INTERVAL 6 HOUR) AS time, avg(fork_ms) AS workspace, avg(launch_ms) AS launch, avg(harness_init_ms) AS harness, avg(intro_ms) AS intro, avg(names_ms) AS names, avg(ttft_ms) AS model_wait FROM (SELECT * FROM turns WHERE $__timeFilter(sent_at) AND NOT synthetic AND surface = 'slack' LIMIT 1 BY turn_id) WHERE path = 'new' GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
