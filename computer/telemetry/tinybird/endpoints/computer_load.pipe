DESCRIPTION >
    Work 084 Q10, "load and saturation on the computer", over `[since, until)`: one row per host and `bucket` (minutes, default 5) with the peak of each gauge in it. From `api.sample` (v4 hosts): open journals, runner and host writers, journal bytes on disk, the mirror's unacked spool bytes and largest per-session backlog, frames held for an adoption. From `wire.sample` (while connections are open): wire connections, members, attached sessions (API subscribers), terminals and the largest outbox. From `host.sample`: busy runners and load. Pass `host_id` to see one host.

TOKEN "calvin_read" READ

NODE cl_samples
SQL >
    %
    SELECT host_id, occurred_at, event_name, data
    FROM calvin_events
    WHERE
        event_name IN ('api.sample', 'wire.sample', 'host.sample')
        AND occurred_at >= {{ DateTime(since, required=True) }}
        AND occurred_at < {{ DateTime(until, required=True) }}
        {% if defined(org_id) %} AND org_id = {{ String(org_id) }} {% end %}
        {% if defined(host_id) %} AND host_id = {{ String(host_id) }} {% end %}
    LIMIT 1 BY event_id

NODE endpoint
SQL >
    %
    SELECT
        toStartOfInterval(occurred_at, toIntervalMinute({{ Int32(bucket, 5) }})) AS time,
        host_id,
        maxIf(JSONExtractUInt(data, 'host_protocol'), event_name = 'api.sample') AS host_protocol,
        maxIf(JSONExtractUInt(data, 'open_journals'), event_name = 'api.sample') AS open_journals,
        maxIf(JSONExtractUInt(data, 'runner_writers'), event_name = 'api.sample') AS runner_writers,
        maxIf(JSONExtractUInt(data, 'host_writers'), event_name = 'api.sample') AS host_writers,
        maxIf(JSONExtractUInt(data, 'journal_bytes'), event_name = 'api.sample') AS journal_bytes,
        maxIf(JSONExtractUInt(data, 'mirror_spooled_bytes'), event_name = 'api.sample') AS mirror_spooled_bytes,
        maxIf(JSONExtractUInt(data, 'mirror_unacked_max'), event_name = 'api.sample') AS mirror_unacked_max,
        maxIf(JSONExtractUInt(data, 'held_frames'), event_name = 'api.sample') AS held_frames,
        maxIf(JSONExtractUInt(data, 'connections'), event_name = 'wire.sample') AS connections,
        maxIf(JSONExtractUInt(data, 'members'), event_name = 'wire.sample') AS members,
        maxIf(JSONExtractUInt(data, 'attached'), event_name = 'wire.sample') AS attached,
        maxIf(JSONExtractUInt(data, 'terminals'), event_name = 'wire.sample') AS terminals,
        maxIf(JSONExtractUInt(data, 'queued_bytes_max'), event_name = 'wire.sample') AS queued_bytes_max,
        maxIf(JSONExtractUInt(data, 'busy_runners'), event_name = 'host.sample') AS busy_runners,
        maxIf(JSONExtractFloat(data, 'load1'), event_name = 'host.sample') AS load1
    FROM cl_samples
    GROUP BY time, host_id
    ORDER BY time, host_id

TYPE ENDPOINT
