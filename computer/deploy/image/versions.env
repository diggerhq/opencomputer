# The exact version of everything the Containerfile installs by version (work 103).
# The workflow passes each line as a build argument; nothing is installed as `latest`.
# This file owns these versions for the session image; deploy/vm/provision.sh keeps its
# own for the host until work 103 step 12. Changing a line changes the image tag.
# Resolved on 2026-11-12: Node and Go are the patches provision.sh picked that day
# (latest-v24.x, the latest stable 1.27); the rest were the current releases.
NODE_VERSION=24.22.3
GO_VERSION=1.27.4
UV_VERSION=0.13.8
GH_VERSION=2.103.3
PLAYWRIGHT_VERSION=1.64.1
# Pinned with the harness: it speaks this version's app-server protocol (work 082).
CODEX_VERSION=0.163.0
CLAUDE_CODE_VERSION=2.1.322
OPENCOMPUTER_CLI_VERSION=0.7.23
