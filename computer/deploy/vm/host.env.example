# /etc/slack-presence/host.env — the host agent's identity. root:root, mode 0600.
# systemd reads it for slack-presence-host.service; the agent user cannot.
# provision.sh writes it when run with SP_GATEWAY_URL/SP_HOST_TOKEN/SP_HOST_ID
# (the hosts get theirs when the backend creates them; elsewhere by
# hand or from the Node gateway's /setup "Host" step), and keeps it on re-runs.
#
# Set by the unit, not here: SP_DATA=/data, SP_RUN=/run/slack-presence,
# SP_DEFINITION=/opt/slack-presence/current/definitions/computer.json,
# SP_VERSION (the release's commit), HOME, PATH.

# The gateway's host endpoint (outbound WebSocket; the VM needs no ingress).
SP_GATEWAY_URL=wss://<gateway>/host

# Bearer token issued by /setup (or listed in the gateway's SP_HOST_TOKENS).
SP_HOST_TOKEN=replace-me

# Keep this stable across VM replacements: the people table routes people to a
# host id, so a replacement VM with the same id takes over without edits.
SP_HOST_ID=shared-vm

# Optional, work 054: performance telemetry to the collector Worker. Unset:
# the host validates and discards. The credential is signed by the backend for
# this host and organization; the gateway's welcome renews it.
# SP_TELEMETRY_URL=https://telemetry.opencomputer.dev
# SP_TELEMETRY_CREDENTIAL=<signed credential>
# SP_REGION=westus2
# SP_SUBSTRATE=vm
