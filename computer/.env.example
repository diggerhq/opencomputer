# No setup needed: on first `npm start` the bot opens api.slack.com/apps and asks you to
# paste a config Refresh Token ("Your App Configuration Tokens" → Generate Token).
# It rotates the pair on each start and writes it back here.
# SLACK_CONFIG_REFRESH_TOKEN=xoxe-1-...

# Written by `npm start` (don't fill in): SLACK_APP_ID, SLACK_CLIENT_ID, SLACK_CLIENT_SECRET,
# SLACK_SIGNING_SECRET, SLACK_STATE_SECRET, SLACK_BOT_TOKEN, SLACK_TEAM_ID, ...

# Optional
# SLACK_APP_NAME=Computer
# NGROK_URL=my-name.ngrok.app   # pin a reserved ngrok domain; default: ngrok picks
# PUBLIC_URL=https://...        # bring your own tunnel instead of ngrok
# PORT=3170
# WORKDIR=/path/to/a/checkout   # every session works here; default: ./workspaces/<session> scratch git repos
# PERMISSION_MODE=bypassPermissions  # default (ask) | acceptEdits | plan | auto | bypassPermissions
# MODEL=claude-opus-5-5   (default when unset; !model <id> per thread)
# STREAMING=off                 # force the chat.update fallback renderer
# FLUSH_MS=600                  # appendStream batching window
