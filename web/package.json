    "prettier": "^3.8.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
