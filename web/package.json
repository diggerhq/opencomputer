{
  "name": "opensandbox-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:preview": "VITE_PREVIEW=1 vite",
    "build": "tsc -b && vite build",
    "build:desktop": "vite build -c vite.desktop.config.ts",
    "dev:desktop": "vite -c vite.desktop.config.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.50",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@pierre/diffs": "^1.7.1",
    "@posthog/react": "^1.10.3",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@uiw/react-codemirror": "^4.25.13",
    "ai": "^7.0.47",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.21.0",
    "node-diff3": "^4.0.0",
    "posthog-js": "^1.395.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tinykeys": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.1.0"
